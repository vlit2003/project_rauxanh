generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  ADMIN_TONG
  QL_DONVI
  NHANVIEN
  KIEMTRA
}

enum BatchStatus {
  ACTIVE
  EXPIRED
  EMPTY
  CANCELLED
}

enum MovementType {
  IN
  OUT
  ADJUST
  LOSS
  TRANSFER_OUT
  TRANSFER_IN
}

enum HerdStatus {
  ACTIVE
  CLOSED
}

enum LivestockEventType {
  BUY
  BIRTH
  DEATH
  SICK
  SELL
  WEIGHT
  TRANSFER_OUT
  TRANSFER_IN
}

enum TransferStatus {
  PROPOSED
  APPROVED
  REJECTED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum TransferItemType {
  BATCH
  HERD
}

model Unit {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())

  users        User[]
  batches      Batch[]
  herds        Herd[]
  demandPlans  DemandPlan[]
  transfersOut Transfer[] @relation("TransferFrom")
  transfersIn  Transfer[] @relation("TransferTo")
}

model Role {
  id    Int      @id @default(autoincrement())
  code  RoleCode @unique
  name  String
  users User[]
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  fullName     String
  isActive     Boolean  @default(true)
  roleId       Int
  unitId       Int?
  createdAt    DateTime @default(now())

  role      Role       @relation(fields: [roleId], references: [id])
  unit      Unit?      @relation(fields: [unitId], references: [id])
  auditLogs AuditLog[]
}

model ProductGroup {
  id       Int       @id @default(autoincrement())
  name     String
  products Product[]
}

model Product {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  name          String
  groupId       Int
  unitOfMeasure String   @default("kg")
  shelfLifeDays Int
  isActive      Boolean  @default(true)

  group   ProductGroup @relation(fields: [groupId], references: [id])
  batches Batch[]
}

model Species {
  id    Int    @id @default(autoincrement())
  code  String @unique
  name  String
  herds Herd[]
}

model Supplier {
  id         Int     @id @default(autoincrement())
  name       String
  phone      String?
  sourceType String
  batches    Batch[]
}

model Batch {
  id              Int         @id @default(autoincrement())
  code            String      @unique
  productId       Int
  unitId          Int
  supplierId      Int?
  grade           String
  initialQty      Decimal     @db.Decimal(12, 2)
  currentQty      Decimal     @db.Decimal(12, 2)
  expectedLossPct Decimal     @db.Decimal(5, 2) @default(0)
  receivedAt      DateTime    @db.Date
  expiresAt       DateTime    @db.Date
  status          BatchStatus @default(ACTIVE)
  deletedAt       DateTime?
  createdBy       Int?
  createdAt       DateTime    @default(now())

  product       Product         @relation(fields: [productId], references: [id])
  unit          Unit            @relation(fields: [unitId], references: [id])
  supplier      Supplier?       @relation(fields: [supplierId], references: [id])
  movements     StockMovement[]
  transferItems TransferItem[]

  @@index([unitId, productId, status, expiresAt])
}

model StockMovement {
  id        Int          @id @default(autoincrement())
  batchId   Int
  type      MovementType
  qty       Decimal      @db.Decimal(12, 2)
  refType   String?
  refId     Int?
  reason    String?
  createdBy Int?
  createdAt DateTime     @default(now())

  batch Batch @relation(fields: [batchId], references: [id])

  @@index([batchId, createdAt])
}

model Herd {
  id          Int        @id @default(autoincrement())
  code        String     @unique
  speciesId   Int
  unitId      Int
  headCount   Int
  avgWeightKg Decimal    @db.Decimal(8, 2) @default(0)
  startedAt   DateTime   @db.Date
  status      HerdStatus @default(ACTIVE)
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())

  species       Species          @relation(fields: [speciesId], references: [id])
  unit          Unit             @relation(fields: [unitId], references: [id])
  events        LivestockEvent[]
  transferItems TransferItem[]

  @@index([unitId, speciesId])
}

model LivestockEvent {
  id         Int                @id @default(autoincrement())
  herdId     Int
  type       LivestockEventType
  headsDelta Int                @default(0)
  weightKg   Decimal?           @db.Decimal(8, 2)
  reason     String?
  refType    String?
  refId      Int?
  createdBy  Int?
  createdAt  DateTime           @default(now())

  herd Herd @relation(fields: [herdId], references: [id])

  @@index([herdId, createdAt])
}

model DemandPlan {
  id          Int      @id @default(autoincrement())
  unitId      Int
  itemType    String
  productId   Int?
  speciesId   Int?
  qty         Decimal  @db.Decimal(12, 2)
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  unit Unit @relation(fields: [unitId], references: [id])

  @@index([unitId, itemType])
}

model Transfer {
  id           Int            @id @default(autoincrement())
  code         String         @unique
  fromUnitId   Int
  toUnitId     Int
  status       TransferStatus @default(PROPOSED)
  requestedBy  Int?
  approvedBy   Int?
  dispatchedAt DateTime?
  receivedAt   DateTime?
  note         String?
  createdAt    DateTime       @default(now())

  fromUnit Unit           @relation("TransferFrom", fields: [fromUnitId], references: [id])
  toUnit   Unit           @relation("TransferTo", fields: [toUnitId], references: [id])
  items    TransferItem[]

  @@index([status, toUnitId])
}

model TransferItem {
  id         Int              @id @default(autoincrement())
  transferId Int
  itemType   TransferItemType
  batchId    Int?
  herdId     Int?
  qty        Decimal          @db.Decimal(12, 2)

  transfer Transfer @relation(fields: [transferId], references: [id])
  batch    Batch?   @relation(fields: [batchId], references: [id])
  herd     Herd?    @relation(fields: [herdId], references: [id])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String
  entityId  Int?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
}
